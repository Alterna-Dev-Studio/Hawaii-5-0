{
  "openapi": "3.0.0",
  "info": {
    "title": "UntypedObjectArrayProperty",
    "version": "1.0",
    "description": "Regression fixture for #32: a record property whose array items declare `properties` without `type: \"object\"` must generate a nested record list, not `list<string>`."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/orders/{id}": {
      "get": {
        "summary": "Get an order",
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "properties": {
                "sku": { "type": "string" },
                "quantity": { "type": "integer" }
              },
              "required": ["sku"]
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "properties": {
                "text": { "type": "string" }
              }
            }
          }
        },
        "required": ["id", "lines"]
      }
    }
  }
}
